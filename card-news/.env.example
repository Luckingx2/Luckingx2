# publish_instagram.py 설정 — 이 파일을 복사해 `.env`로 만들고 값을 채우세요.
# ⚠️ 실제 .env 는 절대 깃에 커밋하지 마세요(.gitignore에 등록됨). 토큰을 채팅에 붙여넣지 마세요.

# 인스타 비즈니스/크리에이터 계정의 IG User ID (숫자)
IG_USER_ID=

# 장기(Long-lived) 액세스 토큰
IG_ACCESS_TOKEN=

# 카드 이미지가 '공개'로 접근되는 베이스 URL (끝 슬래시 없이)
#  - 저장소를 Public으로 바꾸면 아래 jsDelivr 형식이 바로 동작합니다(COMMIT은 이미지가 든 커밋 SHA):
#    https://cdn.jsdelivr.net/gh/Luckingx2/Luckingx2@<COMMIT_SHA>/card-news/cards
#  - 또는 GitHub Pages / S3 / 임의 정적 호스팅의 cards 폴더 URL을 넣으세요.
IMAGE_BASE_URL=

# (선택) 캡션 파일 경로 (기본 caption.txt)
# CAPTION_FILE=caption.txt
